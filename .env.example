# OmeGame - Environment Variables

# ===== Frontend (Vercel) =====

# URL of the signaling server (set this to your Render service URL)
# Example: https://omegame-signaling.onrender.com
NEXT_PUBLIC_SIGNALING_URL=

# Metered Open Relay API key for TURN servers (free at https://openrelayproject.org)
# If not set, only Google STUN servers will be used (works for most users)
NEXT_PUBLIC_METERED_API_KEY=


# ===== Signaling Server (Render) =====

# CORS origin - comma-separated list of allowed origins
# Example: https://omegame.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ===== Database (Neon / Render Postgres) =====

# Postgres connection string. Server-side only (never NEXT_PUBLIC).
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ===== PayPal =====

# PayPal Client ID (live: starts with Aa..., sandbox: starts with A...)
# If unset, falls back to the sandbox Client ID in code
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Admin token for the /admin page
ADMIN_TOKEN=
